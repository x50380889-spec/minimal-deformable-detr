{
  "num_classes": 4,
  "seed": 42,
  "device": "auto",
  "image_size": 128,
  "output_dir": "outputs",
  "log_dir": "training_logs",
  "tensorboard_dir": "training_logs/tensorboard",
  "scalars_dir": "training_logs/scalars",
  "data": {
    "train_size": 600,
    "val_size": 200,
    "image_size": 128,
    "max_objects": 5,
    "batch_size": 8,
    "num_workers": 0,
    "seed": 42
  },
  "teacher": {
    "backbone": "simple_cnn",
    "channels": [32, 64, 128, 256],
    "d_model": 128,
    "n_heads": 4,
    "n_points": 4,
    "enc_layers": 2,
    "dec_layers": 2,
    "num_queries": 20,
    "matmul_mode": "einsum",
    "sampling_mode": "native",
    "epochs": 20,
    "lr": 0.0002,
    "weight_decay": 0.0001,
    "lr_milestones": [8, 15]
  },
  "student": {
    "backbone": "mobilenet_v3_small",
    "width_mult": 1.0,
    "d_model": 96,
    "n_heads": 3,
    "n_points": 4,
    "enc_layers": 2,
    "dec_layers": 1,
    "num_queries": 15,
    "matmul_mode": "einsum",
    "sampling_mode": "native",
    "epochs": 15,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "lr_milestones": [8]
  },
  "distill": {
    "teacher_ckpt": "outputs/teacher.pt",
    "epochs": 15,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "lr_milestones": [8],
    "temperature": 4.0,
    "kd_cls_w": 0.5,
    "kd_box_w": 0.5,
    "kd_giou_w": 0.2,
    "kd_feat_w": 0.2,
    "task_cls_w": 1.0,
    "task_box_w": 2.0,
    "task_giou_w": 1.0
  }
}
